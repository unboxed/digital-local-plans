<%= f.govuk_text_field :reference, label: { text: 'Reference', size: 'm' }, hint: { text: 'This is created automatically.' } %>

<%= f.govuk_text_field :plan_reference, label: { text: 'Plan reference', size: 'm' }, hint: { text: 'This is the reference of the plan this event belongs to'}, value: "#{timetable_event.plan}", disabled: true %>

<%= f.govuk_date_field :event_date, legend: { text: 'Planned date', size: 'm' }, hint: { text: 'Enter the date when you expect this event to take place. You can change this later.'} %>
<%= f.govuk_date_field :actual_date, legend: { text: 'Actual date (if applicable)', size: 'm' }, hint: { text: 'Once the event has happened, enter the date that it took place.' } %>

<%= f.govuk_text_area :notes, label: { text: 'Notes', size: 'm' }, hint: { text: 'Enter any comments related to this event date (optional). These will be stored in the CSV.' } %>
