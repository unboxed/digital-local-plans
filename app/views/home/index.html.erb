<h1 class="govuk-heading-m">Welcome</h1>

<% if @timetable %>
<ul class="govuk-list govuk-list--bullet">
  <li class="govuk-!-margin-bottom-2">
    <%= govuk_link_to 'View and update your digital local plan metadata', edit_timetable_path(@timetable) %>
  </li>
  <li>
    <%= govuk_link_to 'View and update your digital local plan timetable', timetables_path %>
  </li>
</ul>
<% else %>
<ul class="govuk-list govuk-list--bullet">
  <li><%= govuk_link_to 'Start a new timetable', new_timetable_path %></li>
</ul>
<% end %>
