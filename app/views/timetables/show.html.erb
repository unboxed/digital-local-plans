<%= content_for :page_title, 'Create timetable' %>
<%= content_for :before_content, govuk_back_link_to(home_path) %>

    <div class="govuk-grid-row">
      <div class="govuk-grid-column-full">
        <div class="app-page-header__title-row">
          <h1 class="govuk-heading-l govuk-!-margin-bottom-0">Enter dates for your timetable</h1>
          <%= govuk_tag(text: @status[:text], colour: @status[:colour]) %>
        </div>
        <p class="govuk-body govuk-hint">The process of creating a local plan from commencement to adoption should take no longer than 30 months.</p>

        <% if @plan_duration %>
          <div class="app-duration-ribbon govuk-body-s govuk-!-font-weight-bold">Your timetable is currently <%= @plan_duration %> months from commencement to adoption</div>
        <% end %>

        <%= govuk_table do |table| %>
          <% table.with_head do |head| %>
            <% head.with_row do |row| %>
              <%= row.with_cell(text: 'Milestone', classes: 'app-table__header--bold-black') %>
              <%= row.with_cell(text: 'Date', classes: 'app-table__header--bold-black') %>
              <%= row.with_cell(text: 'Time Period', classes: 'app-table__header--bold-black') %>
              <%= row.with_cell(text: 'Action', classes: 'app-table__header--bold-black app-table__cell--action') %>
            <% end %>
          <% end %>

          <% table.with_body do |body| %>
            <% @timetable.timetable_events.order(:id).each_with_index do |event, i| %>
              <% body.with_row do |row| %>
                <%= row.with_cell(text: "#{i+1}. #{event.milestone_name}", classes: "govuk-!-font-weight-bold") %>
                <%= row.with_cell(text: event.event_date.present? ? event.event_date.to_fs(:govuk) : "Not yet completed", classes: "govuk-hint") %>
                <%= row.with_cell(text: event.timing_description, classes: "govuk-hint") %>
                <%= row.with_cell do %>
                  <% if event.event_date.present? %>
                    <%= govuk_link_to 'Change', edit_timetable_event_path(event) %>
                  <% else %>
                    <%= govuk_link_to 'Add date', edit_timetable_event_path(event) %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>

        <div class="govuk-!-margin-bottom-6 app-container-top-and-bottom-outline">
          <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Export data</h2>
          <%= govuk_link_to(
                  'Export and open Check and Provide service',
                  'https://provide.planning.data.gov.uk/',
                  target: '_blank',
                  class: 'govuk-body-m',
                  onclick: "window.location.href='#{timetable_timetable_exports_path(@timetable)}';"
                ) %>
          <p class="govuk-body govuk-hint govuk-!-margin-top-2">This will export your timetable as a CSV and open the Check and Provide service in a new tab, where you can upload your CSV.</p>
        </div>
      </div>
    </div>

