<%= content_for :page_title, 'Create timetable' %>
<%= content_for :before_content, govuk_back_link_to(home_path) %>


<div class="govuk-grid-row">
  <div class="govuk-grid-column-three-quarters">
    <div class="app-page-header__title-row">
      <h1 class="govuk-heading-l govuk-!-margin-bottom-0">Create timetable</h1>
      <%= govuk_tag(text: @status[:text], colour: @status[:colour]) %>
    </div>

    <%= govuk_table do |table| %>
      <% table.with_head do |head| %>
        <% head.with_row do |row| %>
          <%= row.with_cell(text: 'Milestone', classes: 'app-table__header--bold-black') %>
          <%= row.with_cell(text: 'Date', classes: 'app-table__header--bold-black') %>
          <%= row.with_cell(text: 'Time Period', classes: 'app-table__header--bold-black govuk-!-width-one-third') %>
          <%= row.with_cell(text: 'Action', classes: 'app-table__header--bold-black') %>
        <% end %>
      <% end %>

      <% table.with_body do |body| %>
        <% @timetable.timetable_events.order(:id).each_with_index do |event, i| %>
          <% body.with_row do |row| %>
            <%= row.with_cell(text: "#{i+1}. #{event.plan_event.tr('-', ' ').humanize}", classes: "govuk-!-font-weight-bold") %>
            <%= row.with_cell(text: event.event_date.present? ? event.event_date.to_fs(:govuk) : "Not yet completed", classes: "govuk-hint") %>
            <%= row.with_cell(text: event.timing_description, classes: "govuk-hint") %>
            <%= row.with_cell do %>
              <% if event.event_date.present? %>
                <%= govuk_link_to 'Change', edit_timetable_event_path(event) %>
              <% else %>
                <%= govuk_link_to 'Add date', edit_timetable_event_path(event) %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>

    <%= govuk_button_link_to "Export CSV", timetable_timetable_exports_path(@timetable) %>
  </div>
</div>
