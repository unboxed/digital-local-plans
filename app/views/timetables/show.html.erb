<%= content_for :page_title, 'Add or change plan milestones' %>
<%= content_for :before_content, govuk_back_link_to(home_path) %>

<h1 class="govuk-heading-m">Add or change plan milestones</h1>

<%= govuk_table do |table| %>
  <% table.with_head do |head| %>
    <% head.with_row do |row| %>
      <%= row.with_cell(text: 'Milestone') %>
      <%= row.with_cell(text: 'Date') %>
      <%= row.with_cell(text: 'Action') %>
    <% end %>
  <% end %>

  <% table.with_body do |body| %>
    <% @timetable.timetable_events.each do |event| %>
      <% body.with_row do |row| %>
        <%= row.with_cell(text: event.plan_event.tr('-', ' ').humanize) %>
        <%= row.with_cell(text: event.event_date.present? ? event.event_date.to_fs(:govuk) : 'Not yet completed') %>
        <%= row.with_cell do %>
          <% if event.event_date.present? %>
            <%= govuk_link_to 'Change', home_path %>
          <% else %>
            <%= govuk_link_to 'Add date', home_path %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
